# ─────────────────────────────────────────────────────────────────────────
# Urban Hydrology Engine — local dev environment
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────

# Supabase connection string (URI format)
# Get from: Supabase Dashboard → Project Settings → Database → URI tab
# Session pooler (port 5432) or transaction pooler (port 6543):
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# ── Optional ──────────────────────────────────────────────────────────────

# OpenWeatherMap API key (free at openweathermap.org)
# Without this, live weather polling is disabled — historical data still works.
OWM_API_KEY=your_owm_api_key_here

# API key for write endpoints (POST /run/cycle, POST /ingest/rain etc.)
# Must match the key hardcoded in the frontend
API_SECRET_KEY=your_api_secret_key_here

# Delhi city centre coordinates
CITY_LAT=28.65
CITY_LON=77.22

# Weather polling interval in seconds (600 = every 10 minutes)
RAIN_POLL_INTERVAL_SECONDS=600
RAIN_COVERAGE_DEGREES=0.15

# pg_tileserv URL — leave empty when running locally without Docker
# (vector tile layer falls back gracefully; map still renders GeoJSON)
TILESERV_URL=

# Render deployment — set to your service URL to enable self-ping keep-alive
# e.g. https://urban-hydrology-engine.onrender.com
RENDER_EXTERNAL_URL=  # Set to your Render URL to enable self-ping keep-alive
